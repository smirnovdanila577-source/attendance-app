{
  "name": "attendance-tracker",
  "version": "1.0.0",
  "description": "Трекер посещаемости",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.tracker.app",
    "productName": "Трекер посещаемости",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!backend/**",
      "!dist/**",
      "!*.txt",
      "!*.bat",
      "!README.md"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Трекер посещаемости",
      "language": "1049",
      "installerLanguages": ["ru_RU"],
      "artifactName": "Tracker-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  }
}